{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins MSPs Org Groups API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MSPs Org Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listMspOrgGroups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/orggroups",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List organization groups defined under this MSP. Organization groups contain related organization IDs and can be used in MSP privilege assignments."
        },
        {
          "info": {
            "name": "createMspOrgGroup",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/orggroups",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an organization group under this MSP with a display name and optional list of member organization IDs."
        },
        {
          "info": {
            "name": "getMspOrgGroup",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/orggroups/:orggroup_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "orggroup_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return the organization group details, including its name and member organization IDs."
        },
        {
          "info": {
            "name": "updateMspOrgGroup",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/orggroups/:orggroup_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "orggroup_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an MSP organization group's display name or member organization IDs."
        },
        {
          "info": {
            "name": "deleteMspOrgGroup",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/orggroups/:orggroup_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "orggroup_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an MSP organization group. This removes the grouping object without deleting the organizations it referenced."
        }
      ]
    }
  ],
  "bundled": true
}