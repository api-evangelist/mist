{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs API Tokens API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs API Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listOrgApiTokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/apitokens",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List organization API tokens, including display names, scoped privileges, allowed source IPs, creator, and last-use metadata."
        },
        {
          "info": {
            "name": "createOrgApiToken",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/apitokens",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an organization API token with a display name, scoped privileges, and optional source IP restrictions.\nNote that the full token key is only available at creation time."
        },
        {
          "info": {
            "name": "getOrgApiToken",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/apitokens/:apitoken_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "apitoken_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return metadata for one organization API token. The full token key is only available at creation time and may only be partially shown afterward."
        },
        {
          "info": {
            "name": "updateOrgApiToken",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/apitokens/:apitoken_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "apitoken_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an organization API token's display name or scoped privileges. Source IP restrictions are defined when the token is created."
        },
        {
          "info": {
            "name": "deleteOrgApiToken",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/apitokens/:apitoken_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "apitoken_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an organization API token so it can no longer authenticate API requests."
        }
      ]
    }
  ],
  "bundled": true
}