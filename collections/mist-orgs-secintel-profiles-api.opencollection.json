                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an organization SecIntel profile with category-specific protection levels for threat intelligence feeds."
        },
        {
          "info": {
            "name": "getOrgSecIntelProfile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/secintelprofiles/:secintelprofile_id",
            "params": [
