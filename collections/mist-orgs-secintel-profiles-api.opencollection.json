              {
                "name": "secintelprofile_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return an organization SecIntel profile, including the protection level configured for each SecIntel feed category."
        },
        {
          "info": {
            "name": "updateOrgSecIntelProfile",
