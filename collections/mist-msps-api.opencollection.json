{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins MSPs API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MSPs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "createMsp",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/msps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a managed service provider account that can own organizations, organization groups, admins, licenses, and MSP-level settings."
        },
        {
          "info": {
            "name": "getMspDetails",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return MSP account details, including the display name, service tier, support-access setting, logo URL, custom URL, and timestamps."
        },
        {
          "info": {
            "name": "updateMsp",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/msps/:msp_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update editable MSP account settings such as the display name, support-access setting, logo URL, or custom URL."
        },
        {
          "info": {
            "name": "deleteMsp",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/msps/:msp_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete the MSP account and its MSP-level organization groups and privileges. This does not delete any organizations or administrator accounts."
        },
        {
          "info": {
            "name": "searchMspOrgGroup",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/search",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "type",
                "value": "orgs",
                "type": "query",
                "description": "MSP search result type to return. enum: `orgs`"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Filter results by search string"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return per page"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Lower bound of the time range, as an epoch timestamp in seconds or a relative value such as `-1d` or `-1w`"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "Upper bound of the time range, as an epoch timestamp in seconds or a relative value such as `-1d`, `-2h`, or `now`"
              },
              {
                "name": "duration",
                "value": "",
                "type": "query",
                "description": "Time range duration for the query, using relative units such as `10m`, `7d`, or `2w`"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "On which field the list should be sorted, -prefix represents DESC order"
              }
            ]
          },
          "docs": "Search MSP resources by query string. Currently `type=orgs` returns matching organizations in this MSP."
        }
      ]
    }
  ],
  "bundled": true
}