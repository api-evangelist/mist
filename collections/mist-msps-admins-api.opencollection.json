{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins MSPs Admins API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MSPs Admins",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listMspAdmins",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/admins",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List administrators that have privileges in this MSP hierarchy, including MSP, organization, organization group, site, or site group scopes."
        },
        {
          "info": {
            "name": "getMspAdmin",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/admins/:admin_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "admin_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return administrator details and privilege assignments for one administrator under this MSP."
        },
        {
          "info": {
            "name": "updateMspAdmin",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/admins/:admin_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "admin_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update identity fields and privilege assignments for an existing administrator under this MSP."
        },
        {
          "info": {
            "name": "revokeMspAdmin",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/admins/:admin_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "admin_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove all privileges this administrator has through the MSP hierarchy, including inherited organization and site access. This does not delete the administrator account."
        },
        {
          "info": {
            "name": "inviteMspAdmin",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/invites",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send an MSP administrator invitation with the requested identity fields and privilege assignments.\n\n**Note**: An email will also be sent to the user with a link to https://manage.mist.com/verify/invite?token=:token"
        },
        {
          "info": {
            "name": "updateMspAdminInvite",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/invites/:invite_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "invite_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the identity fields or privilege assignments on a pending MSP administrator invitation."
        },
        {
          "info": {
            "name": "uninviteMspAdmin",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/invites/:invite_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "invite_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel a pending MSP administrator invitation before the invitee accepts it."
        }
      ]
    }
  ],
  "bundled": true
}