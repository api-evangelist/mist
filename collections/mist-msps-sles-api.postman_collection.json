{
  "item": [
    {
      "id": "38524d85-bf72-4a23-9bba-d93cb9e07cb3",
      "name": "MSPs SLEs",
      "description": {
        "content": "SLEs, or Service-Level Expectations, are metrics used to monitor and report on the user experience of a Wireless, Wired or Wan network.\n\nThey are generated through data science and machine learning algorithms and provide insights into various aspects of the network, such as coverage, capacity, connectivity, and performance.\n\nMist SLEs help identify when users do not have sufficient network quality, when they face issues with connecting or roaming between access points, and when there are problems on the wired network.\n\nSLEs API Calls at the MSP level can be used to retrieve the SLEs summary for each Organization attached to the MSP account.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "dab9581f-b676-4da9-b296-ded6dbb91029",
          "name": "getMspSle",
          "request": {
            "name": "getMspSle",
            "description": {
              "content": "Return MSP-level SLE insight metrics for the selected metric and time range. Depending on the metric, the response can include all organizations or the worst-performing organizations in the MSP.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "msps",
                ":msp_id",
                "insights",
                ":metric"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sle",
                  "value": "<string>",
                  "description": "See [List Insight Metrics](/#operations/listInsightMetrics) for more details"
                },
                {
                  "disabled": false,
                  "key": "duration",
                  "value": "1d",
                  "description": "Time range duration for the query, using relative units such as `10m`, `7d`, or `2w`"
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "Aggregation works by giving a time range plus interval (e.g. 1d, 1h, 10m) where aggregation function would be applied to."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Lower bound of the time range, as an epoch timestamp in seconds or a relative value such as `-1d` or `-1w`"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "Upper bound of the time range, as an epoch timestamp in seconds or a relative value such as `-1d`, `-2h`, or `now`"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "msp_id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "metric",
                  "description": "(Required) See [List Insight Metrics](/#operations/listInsightMetrics) for available metrics"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
