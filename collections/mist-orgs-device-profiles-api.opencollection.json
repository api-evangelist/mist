              },
              {
                "name": "deviceprofile_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assign Org Device Profile to Devices"
        },
        {
          "info": {
            "name": "unassignOrgDeviceProfile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/deviceprofiles/:deviceprofile_id/unassign",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "deviceprofile_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Unassign Org Device Profile from Devices"
        }
      ]
    }
  ],
  "bundled": true
}