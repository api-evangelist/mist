              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "deviceprofile_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the AP, switch, or gateway configuration stored in a specific org-level device profile."
        },
        {
          "info": {
            "name": "updateOrgDeviceProfile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/deviceprofiles/:deviceprofile_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "deviceprofile_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the AP, switch, or gateway configuration stored in an org-level device profile."
        },
        {
          "info": {
            "name": "deleteOrgDeviceProfile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/deviceprofiles/:deviceprofile_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "deviceprofile_id",
                "value": "",
                "type": "path"
              }
            ]
          },
