{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs SDK Templates API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs SDK Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listSdkTemplates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/sdktemplates",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List SDK templates configured for the organization. SDK templates define visual customization for the mobile SDK experience, including branding images, colors, header text, and welcome messages."
        },
        {
          "info": {
            "name": "createSdkTemplate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/sdktemplates",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an SDK template that defines visual customization for the mobile SDK experience, including branding images, colors, header text, and welcome messages."
        },
        {
          "info": {
            "name": "getSdkTemplate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/sdktemplates/:sdktemplate_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sdktemplate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return the visual customization settings for an SDK template, including branding text, image URLs, colors, default state, and site scope."
        },
        {
          "info": {
            "name": "updateSdkTemplate",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/sdktemplates/:sdktemplate_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sdktemplate_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an SDK template's visual customization settings, such as branding images, colors, header text, welcome message, default state, or site association."
        },
        {
          "info": {
            "name": "deleteSdkTemplate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/sdktemplates/:sdktemplate_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sdktemplate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an SDK visual customization template from the organization."
        }
      ]
    }
  ],
  "bundled": true
}