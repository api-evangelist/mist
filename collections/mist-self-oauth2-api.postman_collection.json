  "item": [
    {
      "id": "7bebd993-5eca-4175-8854-b6dc21fb1b3e",
      "name": "Self OAuth2",
      "description": {
        "content": "A Mist account can be linked to OAuth2 providers:\n  1. First, login with your Mist account\n  2. Obtain the Authorization URL for Linking\n  3. Obtain the authorization code by clicking / going through Authorization URL\n  4. Link Mist Account against OAuth2 Provider by using the authorization code",
        "type": "text/plain"
      },
