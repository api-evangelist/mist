{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs Integration Cradlepoint API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs Integration Cradlepoint",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "testOrgCradlepointConnection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/setting/cradlepoint/setup",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Test the current Cradlepoint integration configuration and return whether the most recent integration status is active or inactive."
        },
        {
          "info": {
            "name": "setupOrgCradlepointConnectionToMist",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/setting/cradlepoint/setup",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure the Cradlepoint integration by storing Cradlepoint API and ECM credentials and setting up Cradlepoint webhooks to send events to Mist."
        },
        {
          "info": {
            "name": "updateOrgCradlepointConnectionToMist",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/setting/cradlepoint/setup",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the stored Cradlepoint API and ECM credentials and the LLDP-based device linking option used by Mist."
        },
        {
          "info": {
            "name": "deleteOrgCradlepointConnection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/setting/cradlepoint/setup",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove the Cradlepoint integration configuration from the organization."
        },
        {
          "info": {
            "name": "syncOrgCradlepointRouters",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/setting/cradlepoint/sync",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Trigger a Cradlepoint device synchronization with Mist. When LLDP linking is enabled, Mist also uses Cradlepoint LLDP data to associate routers with Mist sites and devices."
        }
      ]
    }
  ],
  "bundled": true
}