{
  "item": [
    {
      "id": "9c0ec695-604a-45e4-bbb4-73b1d07f8531",
      "name": "Orgs SLEs",
      "description": {
        "content": "Org SLEs, or Service-Level Expectations, are metrics used to monitor and report on the user experience of a Wireless, Wired or Wan network.\n\nThey are generated through data science and machine learning algorithms and provide insights into various aspects of the network, such as coverage, capacity, connectivity, and performance.\n\nMist SLEs help identify when users do not have sufficient network quality, when they face issues with connecting or roaming between access points, and when there are problems on the wired network.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ee350685-5679-4f21-b4c5-1936027b44ef",
          "name": "getOrgSitesSle",
          "request": {
            "name": "getOrgSitesSle",
            "description": {
              "content": "Return per-site Service-Level Expectation (SLE) scores for Wi-Fi, wired, or WAN service over the requested time window.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "orgs",
                ":org_id",
                "insights",
                "sites-sle"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sle",
                  "value": "<string>",
                  "description": "Filter insights by SLE name. enum: `wan`, `wifi`, `wired`"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Lower bound of the time range, as an epoch timestamp in seconds or a relative value such as `-1d` or `-1w`"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "Upper bound of the time range, as an epoch timestamp in seconds or a relative value such as `-1d`, `-2h`, or `now`"
                },
                {
                  "disabled": false,
                  "key": "duration",
                  "value": "1d",
                  "description": "Time range duration for the query, using relative units such as `10m`, `7d`, or `2w`"
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "Aggregation works by giving a time range plus interval (e.g. 1d, 1h, 10m) where aggregation function would be applied to."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results to return per page"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Select the page number to return when using page-based pagination; starts at `1`"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "org_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
