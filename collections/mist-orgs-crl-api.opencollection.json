{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs CRL API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs CRL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getOrgCrlFile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/crl",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download the organization certificate revocation list (CRL) file used to identify certificates that should no longer be trusted."
        }
      ]
    }
  ],
  "bundled": true
}