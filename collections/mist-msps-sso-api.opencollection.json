{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins MSPs SSO API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MSPs SSO",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listMspSsos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List SSO identity provider configurations defined for this MSP."
        },
        {
          "info": {
            "name": "createMspSso",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an MSP SSO identity provider configuration, including provider settings and role-handling behavior."
        },
        {
          "info": {
            "name": "getMspSso",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return one MSP SSO identity provider configuration, including provider settings and generated SSO URLs."
        },
        {
          "info": {
            "name": "updateMspSso",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an MSP SSO identity provider configuration, such as IdP URLs, certificates, issuer, NameID format, and unmatched-role handling."
        },
        {
          "info": {
            "name": "deleteMspSso",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an MSP SSO identity provider configuration so it can no longer be used for administrator login."
        },
        {
          "info": {
            "name": "deleteMspSsoAdmins",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id/delete_admins",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove SSO-linked MSP administrator accounts by email for this SSO profile."
        },
        {
          "info": {
            "name": "listMspSsoLatestFailures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id/failures",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List recent authentication failures for this MSP SSO configuration, including failure details and captured SAML assertion data when available."
        },
        {
          "info": {
            "name": "getMspSamlMetadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id/metadata",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return generated SAML service provider metadata for this MSP SSO configuration as JSON."
        },
        {
          "info": {
            "name": "downloadMspSamlMetadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/ssos/:sso_id/metadata.xml",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sso_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download generated SAML service provider metadata XML for this MSP SSO configuration.\n\nExample of metadata.xml:\n```xml\n<?xml version=\"1.0\" encoding=\"UTF-8\"?><md:EntityDescriptor xmlns:md=\"urn:oasis:names:tc:SAML:2.0:metadata\" entityID=\"https://api.mist.com/api/v1/saml/5hdF5g/login\" validUntil=\"2027-10-12T21:59:01Z\" xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\">\n  <md:SPSSODescriptor AuthnRequestsSigned=\"false\" WantAssertionsSigned=\"true\" protocolSupportEnumeration=\"urn:oasis:names:tc:SAML:2.0:pr"
        }
      ]
    }
  ],
  "bundled": true
}