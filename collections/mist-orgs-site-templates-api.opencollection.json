                "name": "sitetemplate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return a site template, including automatic upgrade settings and template variables available to WLAN configuration."
        },
        {
          "info": {
            "name": "updateOrgSiteTemplate",
