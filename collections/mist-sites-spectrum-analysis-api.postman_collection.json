              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"band\": \"<string>\",\n  \"channels\": [\n    \"<integer>\",\n    \"<integer>\"\n  ],\n  \"device_id\": \"<uuid>\",\n  \"duration\": 300,\n  \"format\": \"json\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
