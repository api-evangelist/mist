{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Sites Stats - Apps API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sites Stats - Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "countSiteApps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/sites/:site_id/stats/apps/count",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "distinct",
                "value": "",
                "type": "query",
                "description": "Field used to group application statistics count results. enum: `ap`, `app`, `category`, `device_mac`, `port_id`, `service`, `src_ip`, `ssid`, `wcid`, `wlan_id`"
              },
              {
                "name": "device_mac",
                "value": "",
                "type": "query",
                "description": "MAC of the device"
              },
              {
                "name": "app",
                "value": "",
                "type": "query",
                "description": "Filter results by application name"
              },
              {
                "name": "wired",
                "value": "",
                "type": "query",
                "description": "If a device is wired or wireless. Default is False."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return per page"
              }
            ]
          },
          "docs": "Count by Distinct Attributes of Applications"
        }
      ]
    }
  ],
  "bundled": true
}