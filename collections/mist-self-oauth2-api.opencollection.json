              },
              {
                "name": "forward",
                "value": "",
                "type": "query",
                "description": "Callback URL to forward to after the OAuth login flow"
              }
            ]
          },
          "docs": "Obtain Authorization URL for Linking"
        },
        {
          "info": {
            "name": "linkOauth2MistAccount",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/self/oauth/:provider",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Link Mist account with an OAuth2 Provider"
        }
      ]
    }
  ],
  "bundled": true
}