{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Admins Logout API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Admins Logout",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "logout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/logout"
          },
          "docs": "End the current authenticated administrator session and invalidate the related login cookies."
        }
      ]
    }
  ],
  "bundled": true
}