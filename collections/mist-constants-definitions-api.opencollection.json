{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Constants Definitions API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Constants Definitions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listApChannels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/ap_channels",
            "params": [
              {
                "name": "country_code",
                "value": "",
                "type": "query",
                "description": "Country code, in two-character"
              }
            ]
          },
          "docs": "Return supported AP radio channels for the requested country code, based on the regulatory domain used by Mist AP configuration."
        },
        {
          "info": {
            "name": "listApLEslVersions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/ap_esl_versions"
          },
          "docs": "Return Electronic Shelf Label (ESL) firmware versions available per AP model."
        },
        {
          "info": {
            "name": "listApLedDefinition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/ap_led_status"
          },
          "docs": "Return AP LED status definitions, including the values used to describe LED behavior and the corresponding `error_code` value."
        },
        {
          "info": {
            "name": "listAppCategoryDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/app_categories"
          },
          "docs": "Return supported application categories used for application identification, traffic classification, and policy matching."
        },
        {
          "info": {
            "name": "listAppSubCategoryDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/app_subcategories"
          },
          "docs": "Return supported application subcategories used for application identification, traffic classification, and policy matching."
        },
        {
          "info": {
            "name": "listApplications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/applications"
          },
          "docs": "Return applications recognized by Juniper Mist devices for traffic classification and application analytics."
        },
        {
          "info": {
            "name": "listCountryCodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/countries",
            "params": [
              {
                "name": "extend",
                "value": "",
                "type": "query",
                "description": "Will include more country codes if true"
              }
            ]
          },
          "docs": "Return supported country codes for Mist configuration. Set `extend=true` to include additional country codes when available."
        },
        {
          "info": {
            "name": "listFingerprintTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/fingerprint_types"
          },
          "docs": "Return supported client fingerprint attribute values (`family`, `model`, `mfg`, and `os_type`) that can be used in [Mist NAC Rules]($h/Orgs%20NAC%20Rules/_overview) `matching` conditions."
        },
        {
          "info": {
            "name": "listGatewayApplications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/gateway_applications"
          },
          "docs": "Return applications recognized by Mist gateways for traffic classification."
        },
        {
          "info": {
            "name": "listInsightMetrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/insight_metrics"
          },
          "docs": "Return supported insight metric names and metadata used by insight and SLE APIs."
        },
        {
          "info": {
            "name": "listSiteLanguages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/languages"
          },
          "docs": "Return supported language codes for localized Mist configuration and user-facing portals."
        },
        {
          "info": {
            "name": "listLicenseTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/license_types"
          },
          "docs": "Return Mist license type definitions used by inventory and subscription APIs."
        },
        {
          "info": {
            "name": "listMarvisClientVersions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/marvisclient_versions"
          },
          "docs": "Return available Marvis Client application versions for tracking or managing Marvis Client deployments."
        },
        {
          "info": {
            "name": "listStates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/states",
            "params": [
              {
                "name": "country_code",
                "value": "",
                "type": "query",
                "description": "Country code, in [two-character](/#operations/listCountryCodes)"
              }
            ]
          },
          "docs": "Return ISO state or province codes for the supplied country code."
        },
        {
          "info": {
            "name": "listTrafficTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/traffic_types"
          },
          "docs": "Return traffic type definitions used to classify recognized network traffic."
        },
        {
          "info": {
            "name": "listWebhookTopics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/webhook_topics"
          },
          "docs": "Return webhook topic definitions that can be subscribed to in webhook configuration."
        }
      ]
    }
  ],
  "bundled": true
}