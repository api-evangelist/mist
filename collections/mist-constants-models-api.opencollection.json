{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Constants Models API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Constants Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getGatewayDefaultConfig",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/default_gateway_config",
            "params": [
              {
                "name": "model",
                "value": "",
                "type": "query",
                "description": "Device model for which to generate the default gateway config."
              },
              {
                "name": "ha",
                "value": "",
                "type": "query",
                "description": "Whether the config is intended for HA"
              }
            ]
          },
          "docs": "Generate the default gateway configuration for the requested model and HA mode."
        },
        {
          "info": {
            "name": "listDeviceModels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/device_models"
          },
          "docs": "Return AP, Switch and Gateway device models supported by Mist, including their features and capabilities."
        },
        {
          "info": {
            "name": "listMxEdgeModels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/mxedge_models"
          },
          "docs": "Return Mist Edge models supported by Mist, including their capabilities."
        },
        {
          "info": {
            "name": "listSupportedOtherDeviceModels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/otherdevice_models"
          },
          "docs": "Return supported models for other or third-party devices."
        }
      ]
    }
  ],
  "bundled": true
}