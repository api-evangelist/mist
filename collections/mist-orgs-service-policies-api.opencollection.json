{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs Service Policies API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs Service Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listOrgServicePolicies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/servicepolicies",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Select the page number to return when using page-based pagination; starts at `1`"
              }
            ]
          },
          "docs": "List organization-level service policies. Service policies match tenants to services or service groups and define the allow or deny action plus optional inspection controls."
        },
        {
          "info": {
            "name": "createOrgServicePolicy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/servicepolicies",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an organization-level service policy that matches tenants\nto services and applies an allow or deny action with optional security inspection\nsettings.\n\n\nOrganization-level service policies can be imported in the gateway templates and gateway policies."
        },
        {
          "info": {
            "name": "getOrgServicePolicy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/servicepolicies/:servicepolicy_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "servicepolicy_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return an organization-level service policy, including the matched tenants and services, action, local routing, path preference, and inspection settings."
        },
        {
          "info": {
            "name": "updateOrgServicePolicy",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/servicepolicies/:servicepolicy_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "servicepolicy_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an organization-level service policy, including its tenant and service matches, action, local routing, path preference, or inspection settings."
        },
        {
          "info": {
            "name": "deleteOrgServicePolicy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/servicepolicies/:servicepolicy_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "servicepolicy_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove an organization-level service policy from the available policy set."
        }
      ]
    }
  ],
  "bundled": true
}