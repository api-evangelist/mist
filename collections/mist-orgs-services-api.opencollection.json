{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs Services API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs Services",
        "type": "folder"
      },
