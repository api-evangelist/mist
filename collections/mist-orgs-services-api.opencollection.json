            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/services",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Select the page number to return when using page-based pagination; starts at `1`"
              }
            ]
          },
          "docs": "List organization service definitions. Services describe applications, application categories, URLs, hostnames, subnets, or custom protocol and port match criteria used by gateway and SSR policies."
        },
        {
          "info": {
            "name": "createOrgService",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/services",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an organization service definition with the match criteria\nused by gateway and SSR policies, such as applications, URLs, hostnames,\nsubnets, or custom protocol and port rules.\n\n\nServices can be user in the service policies to allow or deny traffic matching the service or to apply specific inspection settings or steering rules."
        },
        {
          "info": {
            "name": "getOrgService",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/services/:service_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "service_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return an organization service definition, including its matching mode, match values, traffic classification, and optional SSR path-selection thresholds."
        },
        {
          "info": {
            "name": "updateOrgService",
            "type": "http"
          },
          "http": {
