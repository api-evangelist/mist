            "url": "https://api.mist.com/api/v1/orgs/:org_id/services/:service_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "service_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an organization service definition, including its matching mode, match values, traffic classification, or optional SSR path-selection thresholds."
        },
        {
          "info": {
            "name": "deleteOrgService",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/services/:service_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "service_id",
                "value": "",
                "type": "path"
              }
            ]
