{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Self API Token API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Self API Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listApiTokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/self/apitokens"
          },
          "docs": "Get List of Current User API Tokens"
        },
        {
          "info": {
            "name": "createApiToken",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/self/apitokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create API Token\nNote that the key is only available during creation time."
        },
        {
          "info": {
            "name": "getApiToken",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/self/apitokens/:apitoken_id",
            "params": [
              {
                "name": "apitoken_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get User API Token"
        },
        {
          "info": {
            "name": "updateApiToken",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/self/apitokens/:apitoken_id",
            "params": [
              {
                "name": "apitoken_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update User API Token"
        },
        {
          "info": {
            "name": "deleteApiToken",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/self/apitokens/:apitoken_id",
            "params": [
              {
                "name": "apitoken_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an API Token"
        }
      ]
    }
  ],
  "bundled": true
}