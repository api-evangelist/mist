{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs NAC Tags API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs NAC Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listOrgNacTags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/nactags",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "type",
                "value": "match,vlan",
                "type": "query",
                "description": "Filter results by type. enum: `egress_vlan_names`, `gbp_tag`, `match`, `radius_attrs`, `radius_group`, `radius_vendor_attrs`, `redirect_nacportal_id`, `session_timeout`, `username_attr`, `vlan`. Accepts multiple comma-separated values."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter results by name. Accepts multiple comma-separated values."
              },
              {
                "name": "match",
                "value": "ssid,idp_role",
                "type": "query",
                "description": "if `type`==`match`, Type of NAC Tag. enum: `cert_cn`, `cert_eku`, `cert_issuer`, `cert_san`, `cert_serial`, `cert_sub`, `cert_template`, `client_mac`, `edr_status`, `gbp_tag`, `hostname`, `idp_role`, `ingress_vlan`, `mdm_status`, `nas_ip`, `radius_group`, `realm`, `ssid`, `user_name`, `usermac_label`. Accepts multiple comma-separated values."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Select the page number to return when using page-based pagination; starts at `1`"
              }
            ]
          },
          "docs": "List organization NAC tags, optionally filtering by tag type, name, or match attribute."
        },
        {
          "info": {
            "name": "createOrgNacTag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/nactags",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a NAC tag used either as rule-matching criteria or as a result attribute returned when NAC allows access."
        },
        {
          "info": {
            "name": "getOrgNacTag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/nactags/:nactag_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "nactag_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve configuration details for a specific NAC tag, including type, match values, RADIUS attributes, VLAN or session results, and portal redirection settings."
        },
        {
          "info": {
            "name": "updateOrgNacTag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/nactags/:nactag_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "nactag_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a NAC tag, including matcher values or result attributes such as RADIUS attributes, VLAN, session timeout, username attribute, or portal redirection."
        },
        {
          "info": {
            "name": "deleteOrgNacTag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/nactags/:nactag_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "nactag_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an organization NAC tag by tag ID so it can no longer be used by NAC rules."
        }
      ]
    }
  ],
  "bundled": true
}