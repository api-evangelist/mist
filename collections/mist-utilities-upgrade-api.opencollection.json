            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a queued Mist Edge upgrade request, such as target versions, rollout strategy, start time, or target Mist Edge IDs. Only upgrades in `queued` state can be updated."
        },
        {
          "info": {
            "name": "cancelOrgMxEdgeUpgrade",
