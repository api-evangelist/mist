    {
      "info": {
        "name": "Utilities Upgrade",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listOrgDeviceUpgrades",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/devices/upgrade",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List organization-level device upgrade jobs, including the site-level upgrade jobs created under each organization upgrade."
        },
        {
          "info": {
            "name": "upgradeOrgDevices",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/devices/upgrade",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start an organization-level device upgrade job across selected sites. The request selects device type, sites, models, firmware versions, and upgrade strategy; AP-specific and Junos-specific options apply only where supported."
        },
        {
          "info": {
            "name": "getOrgDeviceUpgrade",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/devices/upgrade/:upgrade_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "upgrade_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve details for an organization-level device upgrade job, including per-site upgrade status and device targets."
        },
        {
          "info": {
            "name": "cancelOrgDeviceUpgrade",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/devices/upgrade/:upgrade_id/cancel",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "upgrade_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel an organization-level device upgrade job on a best-effort basis. Devices that have already completed the upgrade are not changed."
        },
        {
          "info": {
            "name": "listOrgAvailableDeviceVersions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/devices/versions",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter results by type. enum: `ap`, `gateway`, `switch`"
              },
              {
                "name": "model",
                "value": "",
                "type": "query",
                "description": "Fetch version for device model, use/combine with `type` as needed (for switch and gateway devices). Accepts multiple comma-separated values."
              }
            ]
          },
          "docs": "List available firmware versions for organization devices, optionally filtered by device type and model."
        },
        {
          "info": {
            "name": "upgradeOrgJsiDevice",
            "type": "http"
          },
