              },
              {
                "name": "device_mac",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start a software upgrade for a JSI-connected device identified by MAC address using the requested target version."
        },
        {
          "info": {
            "name": "listOrgMxEdgeUpgrades",
