{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Orgs RF Templates API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orgs RF Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listOrgRfTemplates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/rftemplates",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Select the page number to return when using page-based pagination; starts at `1`"
              }
            ]
          },
          "docs": "List organization RF templates used by RRM to apply radio settings across sites."
        },
        {
          "info": {
            "name": "createOrgRfTemplate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/rftemplates",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an organization RF template with 2.4, 5, and 6 GHz radio\nsettings, country code, scanning behavior, antenna gain, and model-specific\noverrides.\n\nTo assign a RF template to a site, use the [Update Site](/#operations/updateSiteInfo) endpoint and specify the RF template ID in the `rftemplate_id` field of the request body."
        },
        {
          "info": {
            "name": "getOrgRfTemplate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/rftemplates/:rftemplate_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "rftemplate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve details for a specific organization RF template, including radio settings, country code, scanning behavior, antenna gain, and model-specific overrides."
        },
        {
          "info": {
            "name": "updateOrgRfTemplate",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/rftemplates/:rftemplate_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "rftemplate_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an organization RF template, including radio settings, country code, scanning behavior, antenna gain, and model-specific overrides."
        },
        {
          "info": {
            "name": "deleteOrgRfTemplate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mist.com/api/v1/orgs/:org_id/rftemplates/:rftemplate_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "rftemplate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an organization RF template by template ID so it can no longer be applied to sites."
        }
      ]
    }
  ],
  "bundled": true
}