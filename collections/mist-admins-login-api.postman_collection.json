{
  "item": [
    {
      "id": "5b21107d-29cc-4874-bfb8-456413883071",
      "name": "Admins Login",
      "description": {
        "content": "Login Endpoints when using Login/Password authentication, with or without 2FA.\n\nIf the Login/Password authentication is successful, Mist will add a `csrftoken` cookie that must be added into the later API Requests (please see [csrfToken (Custom Header Signature)]($h/__auth_CsrfToken))",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "08917a27-07f8-44fd-8bf9-5d6d4bf67e6e",
          "name": "login",
          "request": {
            "name": "login",
            "description": {
              "content": "Authenticate an administrator with email and password. A successful login creates the browser session cookies, including the `csrftoken` value used with the `X-CSRFToken` header on later API requests.\n\nWhen 2FA is enabled, either include the `two_factor` code in this request or submit the first factor here and complete the login with [Two Factor](/#operations/twoFactor).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<string>\",\n  \"password\": \"<string>\",\n  \"two_factor\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "0be6420d-0678-4313-ab93-a1bcee744497",
              "name": "Login Success",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v1",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"test@mistsys.com\",\n  \"password\": \"foryoureyesonly\",\n  \"two_factor\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Session Cookie if login/password authentication is successful",
                  "key": "Set-Cookie",
                  "value": "csrftoken=vwvBuq9qkqaKh7lu8tNc0gkvBfEaLAmx; expires=Tue, 15-Mar-2016 19:47:20 GMT; Max-Age=31449600; Path=/"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"email\": \"test@mistsys.com\",\n  \"two_factor_passed\": false,\n  \"two_factor_required\": true\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
