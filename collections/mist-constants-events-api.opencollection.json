{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins Constants Events API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Constants Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listAlarmDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/alarm_defs"
          },
          "docs": "Return alarm type definitions used by alarm search results, alarm templates, and the `alarm` webhook topic. The `example` field shows representative webhook payload content.\nHA cluster node names are returned in the `node` field, when applicable."
        },
        {
          "info": {
            "name": "listClientEventsDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/client_events"
          },
          "docs": "Return client event definitions used by client event search and count APIs, including event keys and metadata."
        },
        {
          "info": {
            "name": "listDeviceEventsDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/device_events"
          },
          "docs": "Return device event definitions used by device event search and count APIs and the `device-events` webhook topic, including event keys and metadata."
        },
        {
          "info": {
            "name": "listMxEdgeEventsDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/mxedge_events"
          },
          "docs": "Return Mist Edge event definitions used by Mist Edge event search and count APIs, and `mexedge-events` webhook topic."
        },
        {
          "info": {
            "name": "listNacEventsDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/nac_events"
          },
          "docs": "Return NAC client event definitions used by NAC client event search and count APIs, and `nac-events` webhook topic."
        },
        {
          "info": {
            "name": "listOtherDeviceEventsDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/otherdevice_events"
          },
          "docs": "Return event definitions for other or third-party devices managed or monitored by Mist."
        },
        {
          "info": {
            "name": "listSystemEventsDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/const/system_events"
          },
          "docs": "Return system event definitions used by system event search APIs."
        }
      ]
    }
  ],
  "bundled": true
}