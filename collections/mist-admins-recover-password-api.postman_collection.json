          "name": "verifyRecoverPassword",
          "request": {
            "name": "verifyRecoverPassword",
            "description": {
              "content": "Verify a password recovery token from the recovery email. This public endpoint does not require authentication. When the token is valid, the user is authenticated for the recovery flow so the client can prompt for and submit a new password.",
              "type": "text/plain"
            },
