{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mist Admins MSPs Licenses API",
    "version": "2606.1.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "MSPs Licenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "claimMspLicense",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/claim",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Claim a license order for this MSP by submitting the activation code from the order."
        },
        {
          "info": {
            "name": "listMspLicenses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/licenses",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return MSP license entitlement, subscription, amendment, and usage summary information."
        },
        {
          "info": {
            "name": "moveOrDeleteMspLicenseToAnotherOrg",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/licenses",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Perform an MSP license action, such as amending license quantity to an organization, deleting a subscription, undoing an amendment, or annotating a subscription."
        },
        {
          "info": {
            "name": "listMspOrgLicenses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mist.com/api/v1/msps/:msp_id/stats/licenses",
            "params": [
              {
                "name": "msp_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return license entitlement, subscription, amendment, and usage statistics for organizations managed by this MSP."
        }
      ]
    }
  ],
  "bundled": true
}