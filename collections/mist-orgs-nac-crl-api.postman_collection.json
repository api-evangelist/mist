        {
          "id": "ecf9022b-6d6b-45ef-b9a9-d5eeadb4bd3c",
          "name": "deleteOrgNacCrl",
          "request": {
            "name": "deleteOrgNacCrl",
            "description": {
              "content": "Delete an uploaded NAC CRL file identified by the file ID assigned when the CRL was uploaded.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
